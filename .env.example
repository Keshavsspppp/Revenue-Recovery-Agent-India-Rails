GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Verified available 2026-09-05. Model ids churn (docs/12-GLOSSARY.md V7):
# openai/gpt-oss-20b, named in the spec, is no longer served.
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
GROQ_TIMEOUT_S=6
GROQ_MAX_RETRIES=1
# Seconds between calls. Derive it, do not guess: divide the token-per-minute limit the
# API reports by the measured cost of one call. On the free tier that was 8000/932 = 8.6
# calls a minute, so ~7s. Without it ~99% of calls come back 429, every one falls through
# to the planner, and the ablation silently measures the rate limiter instead of the model.
#   curl -sD- https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" #     -o/dev/null | grep -i ratelimit
GROQ_MIN_INTERVAL_S=7.5

# ---- Razorpay test mode -------------------------------------------------------------
# Dashboard -> Settings -> API Keys, with the Test Mode toggle on. The adapter refuses to
# start on anything that is not an rzp_test_ key: a live key would move real money on
# behalf of real people.
#
# Optional. Without it the simulated rails run, which is the default and how every
# measured number in this repo is produced.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
